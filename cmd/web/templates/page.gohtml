<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="Run and inspect Temporal workflow examples.">
  <title>Temporal Workflow Lab</title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
  <script defer src="/static/app.js"></script>
  <script defer src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js" crossorigin="anonymous"></script>
  <style>[x-cloak]{display:none!important}</style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <div>
        <p class="eyebrow">Developer console</p>
        <h1>Temporal Workflow Lab</h1>
      </div>
      <p class="header-summary">Run workflow examples concurrently and inspect their results.</p>
    </div>
  </header>

  <main
    id="main-content"
    class="app-shell"
    x-data="workflowLab()"
    x-cloak
  >
    <aside class="workflow-panel" aria-labelledby="workflows-heading">
      <div class="panel-heading">
        <div>
          <p class="section-kicker">Step 1</p>
          <h2 id="workflows-heading">Choose a workflow</h2>
        </div>
        <button
          class="button button-secondary button-compact"
          type="button"
          @click="refreshCatalog()"
          :disabled="refreshing"
          x-text="refreshing ? 'Loading…' : 'Refresh'"
        >
          Refresh
        </button>
      </div>

      <p class="muted" x-show="workflows.length === 0" x-text="emptyCatalogMessage"></p>
      <div id="workflow-list" class="workflow-list" aria-label="Available workflows">
        <template x-for="workflow in workflows" :key="workflow.id">
          <button
            type="button"
            class="workflow-option"
            :aria-pressed="selectedId === workflow.id"
            @click="selectById(workflow.id)"
          >
            <span class="workflow-option-name" x-text="workflow.name"></span>
            <span class="selection-mark" aria-hidden="true" x-text="selectedId === workflow.id ? '✓' : ''"></span>
            <span class="workflow-option-id" x-text="workflow.id"></span>
          </button>
        </template>
      </div>
    </aside>

    <div class="workspace">
      <section class="card configuration-card" aria-labelledby="configuration-heading">
        <div class="section-heading">
          <p class="section-kicker">Step 2</p>
          <h2 id="configuration-heading">Configure the run</h2>
        </div>

        <div class="empty-state" x-show="!selectedId">
          <p>Select a workflow to review its description and input payload.</p>
        </div>

        <form
          id="run-form"
          x-show="selectedId"
          x-cloak
          novalidate
          hx-post="/runs"
          hx-target="#runs-list"
          hx-swap="afterbegin"
          hx-disabled-elt="none"
          @submit="onSubmit($event)"
          @htmx:config-request="onConfigRequest($event)"
          @htmx:before-request="onBeforeRequest()"
          @htmx:after-request="onAfterRequest()"
          @htmx:send-error="onSendError()"
        >
          <input type="hidden" name="workflow" :value="selectedId">

          <div class="selected-workflow-heading">
            <div>
              <p class="field-label">Selected workflow</p>
              <h3 x-text="selectedName"></h3>
            </div>
            <span class="code-label" x-text="selectedId" :title="selectedId"></span>
          </div>

          <p class="workflow-description" x-text="selectedDescription"></p>

          <fieldset
            class="fan-out-controls"
            x-show="selectedId === 'fan-out-policy'"
            aria-describedby="fan-out-controls-help payload-error"
          >
            <legend>Fan-out experiment</legend>
            <p id="fan-out-controls-help" class="field-help fan-out-controls-help">
              Configure one deterministic campaign for up to 1,000 Activities, then compare how each aggregation policy handles it.
            </p>

            <div class="fan-out-control-grid">
              <label class="control-field" for="fan-out-policy-select">
                <span>Policy</span>
                <select
                  id="fan-out-policy-select"
                  x-model="fanOut.policy"
                  @change="syncFanOutPayload()"
                >
                  <option value="AGGREGATION_POLICY_FAIL_FAST">Fail fast</option>
                  <option value="AGGREGATION_POLICY_ALL_SETTLED">All settled</option>
                  <option value="AGGREGATION_POLICY_ALL_SETTLED_THEN_FAIL">All settled, then fail</option>
                </select>
              </label>

              <label class="control-field" for="fan-out-campaign-select">
                <span>Campaign</span>
                <select
                  id="fan-out-campaign-select"
                  x-model="fanOut.campaignType"
                  @change="syncFanOutPayload()"
                >
                  <option value="FAULT_CAMPAIGN_TYPE_ALL_SUCCESS_V1">All success V1</option>
                  <option value="FAULT_CAMPAIGN_TYPE_MIXED_V1">Mixed V1</option>
                </select>
              </label>

              <label class="control-field" for="fan-out-activity-count">
                <span>Activity count</span>
                <input
                  id="fan-out-activity-count"
                  type="number"
                  step="1"
                  :min="fanOut.campaignType === 'FAULT_CAMPAIGN_TYPE_MIXED_V1' ? 6 : 1"
                  max="1000"
                  inputmode="numeric"
                  x-model="fanOut.activityCount"
                  @input="syncFanOutPayload()"
                >
              </label>

              <label class="control-field" for="fan-out-seed">
                <span>Seed</span>
                <input
                  id="fan-out-seed"
                  type="text"
                  inputmode="numeric"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="fanOut.seed"
                  @input="syncFanOutPayload()"
                >
              </label>
            </div>

            <fieldset
              class="probability-controls"
              x-show="fanOut.campaignType === 'FAULT_CAMPAIGN_TYPE_MIXED_V1'"
            >
              <legend>Background probabilities</legend>
              <div class="probability-control-grid">
                <template x-for="field in fanOutProbabilityFields" :key="field.key">
                  <label class="control-field" :for="`fan-out-probability-${field.key}`">
                    <span x-text="field.label"></span>
                    <input
                      :id="`fan-out-probability-${field.key}`"
                      type="number"
                      min="0"
                      max="100"
                      step="1"
                      inputmode="numeric"
                      x-model="fanOut.probabilities[field.key]"
                      @input="syncFanOutPayload()"
                    >
                  </label>
                </template>
              </div>
              <p class="field-help">All six values must be whole numbers totaling 100.</p>
            </fieldset>
          </fieldset>

          <fieldset
            class="workflow-controls"
            x-show="selectedId === 'reusable-artifacts'"
            aria-describedby="reusable-artifact-controls-help payload-error"
          >
            <legend>Reusable artifact experiment</legend>
            <p id="reusable-artifact-controls-help" class="field-help workflow-controls-help">
              Run five parallel Activities. Reuse is determined by the stable Workflow ID, Activity IDs, and Activity version.
            </p>

            <div class="workflow-control-grid">
              <label class="control-field" for="reusable-artifact-experiment-id">
                <span>Experiment ID</span>
                <input
                  id="reusable-artifact-experiment-id"
                  type="text"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="reusableArtifacts.experimentId"
                  @input="syncReusableArtifactPayload()"
                >
              </label>

              <label class="control-field" for="reusable-artifact-version">
                <span>Activity version</span>
                <input
                  id="reusable-artifact-version"
                  type="text"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="reusableArtifacts.activityVersion"
                  @input="syncReusableArtifactPayload()"
                >
              </label>

              <label class="control-field" for="reusable-artifact-duration">
                <span>Heavy-work duration (seconds)</span>
                <input
                  id="reusable-artifact-duration"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  x-model="reusableArtifacts.heavyWorkSeconds"
                  @input="syncReusableArtifactPayload()"
                >
              </label>

              <label class="control-field" for="reusable-artifact-failure-case">
                <span>Failure case</span>
                <select
                  id="reusable-artifact-failure-case"
                  x-model="reusableArtifacts.failureCase"
                  @change="syncReusableArtifactPayload()"
                >
                  <option value="REUSABLE_ARTIFACT_FAILURE_CASE_NONE">No fault</option>
                  <option value="REUSABLE_ARTIFACT_FAILURE_CASE_BEFORE_PUBLICATION">Fail before publication</option>
                  <option value="REUSABLE_ARTIFACT_FAILURE_CASE_AFTER_PUBLICATION">Fail after publication</option>
                </select>
              </label>

              <label class="control-field" for="reusable-artifact-failure-target">
                <span>Failure target Activity</span>
                <select
                  id="reusable-artifact-failure-target"
                  x-model="reusableArtifacts.failureTargetActivity"
                  @change="syncReusableArtifactPayload()"
                >
                  <option value="artifact-000">artifact-000</option>
                  <option value="artifact-001">artifact-001</option>
                  <option value="artifact-002">artifact-002</option>
                  <option value="artifact-003">artifact-003</option>
                  <option value="artifact-004">artifact-004</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset
            class="workflow-controls"
            x-show="selectedId === 'durable-report'"
            aria-describedby="durable-report-controls-help payload-error"
          >
            <legend>Durable report pipeline</legend>
            <p id="durable-report-controls-help" class="field-help workflow-controls-help">
              Generate five reusable RustFS artifacts, consume all five, then persist one immutable business report in SQLite.
            </p>

            <div class="workflow-control-grid">
              <label class="control-field" for="durable-report-experiment-id">
                <span>Experiment ID</span>
                <input
                  id="durable-report-experiment-id"
                  type="text"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="durableReport.experimentId"
                  @input="syncDurableReportPayload()"
                >
              </label>

              <label class="control-field" for="durable-report-id">
                <span>Business report ID</span>
                <input
                  id="durable-report-id"
                  type="text"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="durableReport.reportId"
                  @input="syncDurableReportPayload()"
                >
              </label>

              <label class="control-field" for="durable-report-version">
                <span>Activity version</span>
                <input
                  id="durable-report-version"
                  type="text"
                  spellcheck="false"
                  autocomplete="off"
                  x-model="durableReport.activityVersion"
                  @input="syncDurableReportPayload()"
                >
              </label>

              <label class="control-field" for="durable-report-duration">
                <span>Heavy-work duration (seconds)</span>
                <input
                  id="durable-report-duration"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  x-model="durableReport.heavyWorkSeconds"
                  @input="syncDurableReportPayload()"
                >
              </label>

              <label class="control-field" for="durable-report-failure-case">
                <span>Failure case</span>
                <select
                  id="durable-report-failure-case"
                  x-model="durableReport.failureCase"
                  @change="syncDurableReportPayload()"
                >
                  <option value="DURABLE_REPORT_FAILURE_CASE_NONE">No fault</option>
                  <option value="DURABLE_REPORT_FAILURE_CASE_AGGREGATION_RETRYABLE">Aggregation retry</option>
                  <option value="DURABLE_REPORT_FAILURE_CASE_PERSIST_BEFORE_COMMIT">Persist failure before commit</option>
                  <option value="DURABLE_REPORT_FAILURE_CASE_PERSIST_AFTER_COMMIT">Persist failure after commit</option>
                </select>
              </label>
            </div>
          </fieldset>

          <div class="field-group">
            <div class="label-row">
              <label for="payload-input" x-text="selectedId === 'fan-out-policy' || selectedId === 'reusable-artifacts' || selectedId === 'durable-report' ? 'Payload preview / editor' : 'Input payload'"></label>
              <span>JSON</span>
            </div>
            <textarea
              id="payload-input"
              name="input"
              rows="14"
              spellcheck="false"
              autocapitalize="off"
              autocomplete="off"
              x-model="payload"
              @input="payloadError = ''"
              :aria-invalid="payloadError ? 'true' : 'false'"
              aria-describedby="payload-help payload-error"
            ></textarea>
            <p
              id="payload-help"
              class="field-help"
              x-text="selectedId === 'fan-out-policy' || selectedId === 'reusable-artifacts' || selectedId === 'durable-report'
                ? 'The controls update this protobuf JSON preview. Raw edits are applied back to the controls after validation when a run starts.'
                : 'Edit the example input, then run. You can start another run while earlier ones are still in flight.'"
            ></p>
            <p id="payload-error" class="field-error" role="alert" x-show="payloadError" x-text="payloadError"></p>
          </div>

          <div class="run-actions">
            <button class="button button-primary" type="submit">
              Run workflow
            </button>
            <button
              class="button button-secondary"
              type="button"
              x-show="selectedId === 'fan-out-policy'"
              :disabled="startingMatrix"
              @click="runAllPolicies()"
              x-text="startingMatrix ? 'Starting policies…' : 'Run all three policies'"
            >
              Run all three policies
            </button>
            <div class="running-indicator" role="status" aria-live="polite" x-show="activeRuns.length + starting > 0">
              <span class="activity-dot" aria-hidden="true"></span>
              <span x-text="inflightLabel"></span>
            </div>
          </div>
        </form>
      </section>

      <section class="runs-section" aria-labelledby="runs-heading">
        <div class="section-heading runs-heading">
          <div>
            <p class="section-kicker">Runs</p>
            <h2 id="runs-heading">In flight and completed</h2>
          </div>
          <button
            type="button"
            class="button button-secondary button-compact"
            x-show="hasCompletedRuns"
            @click="clearCompleted()"
          >
            Clear completed
          </button>
        </div>

        <div id="runs-list" class="runs-stack"></div>

        <div class="empty-state" x-show="activeRuns.length === 0 && starting === 0 && !hasCompletedRuns">
          <p>No runs yet. Configure a workflow and click Run. Live progress will appear here.</p>
        </div>

        <template id="live-run-card-template">
          <article class="card result-card result-pending" tabindex="-1" data-terminal="false" data-revision="0">
            <div class="result-header">
              <div>
                <p class="section-kicker" data-run-kicker>In flight</p>
                <h2 data-run-name></h2>
              </div>
              <span class="status-badge status-warning" data-run-status>Running</span>
            </div>
            <p class="result-message" role="status" data-run-message>The workflow is being monitored for progress.</p>
            <div class="progress-block" data-run-progress>
              <div class="progress-label">
                <span data-run-step>Starting workflow</span>
                <span data-run-percent>0%</span>
              </div>
              <progress max="100" value="0" data-run-progress-bar>0%</progress>
            </div>
            <dl class="metadata-grid">
              <div><dt>Elapsed</dt><dd data-run-elapsed>0ms</dd></div>
              <div><dt>Workflow</dt><dd data-run-workflow></dd></div>
              <div><dt>Workflow ID</dt><dd class="monospace" data-run-workflow-id></dd></div>
              <div><dt>Run ID</dt><dd class="monospace" data-run-id></dd></div>
              <div><dt>Started</dt><dd data-run-started>—</dd></div>
              <div><dt>Finished</dt><dd data-run-finished>—</dd></div>
            </dl>
            <a class="temporal-link" data-run-temporal-link target="_blank" rel="noopener noreferrer">
              Open this run in Temporal UI <span aria-hidden="true">↗</span>
            </a>
            <div class="output-block" data-run-output-block hidden>
              <h3 data-run-output-heading>Result</h3>
              <pre tabindex="0" data-run-output></pre>
            </div>
          </article>
        </template>
      </section>
    </div>
  </main>

  <script id="workflow-catalog" type="application/json">{{.CatalogJSON}}</script>
  <script id="page-config" type="application/json">{{.ConfigJSON}}</script>
</body>
</html>
